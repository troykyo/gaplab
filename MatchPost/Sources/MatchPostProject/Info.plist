<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.photo-project</string>
        <key>NSExtensionPrincipalClass</key>
        <string>ProjectExtensionController</string>
        <key>PHProjectCategory</key>
        <string>book</string>
        <key>PHProjectMaximumAssetCount</key>
        <integer>500</integer>
        <key>PHProjectMinimumAssetCount</key>
        <integer>1</integer>
        <key>PHSupportedMediaTypes</key>
        <array>
            <string>PHSupportedMediaTypeImage</string>
        </array>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>GAP Lab — Amsterdam University of Applied Sciences</string>
    <!-- App Group so this extension shares CoreData with the main app -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.troykyo.matchpost</string>
    </array>
</dict>
</plist>
